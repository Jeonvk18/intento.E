# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

PORT=4000

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
# Ejemplo: mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/encurtidos?retryWrites=true&w=majority
MONGODB_URI=

# Texto largo y aleatorio para firmar los tokens de login
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Credenciales del administrador (las usa "npm run seed" para crearlo)
ADMIN_EMAIL=admin@encurtidos.com
ADMIN_PASSWORD=cambia-esta-clave

# URL del frontend permitido por CORS (separa varias con coma)
# Local: http://localhost:5173  |  GitHub Pages: https://jeonvk18.github.io
CORS_ORIGINS=http://localhost:5173,https://jeonvk18.github.io
